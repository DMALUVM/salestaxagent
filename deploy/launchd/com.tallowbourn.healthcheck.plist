<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Failure-only health check for the Mac Mini sync agent.

  This is NOT a second `src.main run`. It does not start APScheduler.
  StartCalendarInterval uses the Mac system timezone — the Mini must
  stay on America/New_York so this fires at 07:23 ET, after the 07:15
  ads CLEAR deadline and off every scheduled job minute (ga4_sync is
  07:20, gsc_sync is 07:25).

  Success exits 0 and prints nothing. Failures POST to
  GROKBOT_HEALTH_WEBHOOK_URL (from the repo .env). No Telegram.

  No RunAtLoad and no KeepAlive: a nonzero exit must not loop.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tallowbourn.healthcheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/maloney_assistant/sales-tax-agent/.venv/bin/python</string>
        <string>-u</string>
        <string>/Users/maloney_assistant/sales-tax-agent/scripts/healthcheck_wake.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/maloney_assistant/sales-tax-agent</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/maloney_assistant/sales-tax-agent/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>23</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/maloney_assistant/sales-tax-agent/logs/healthcheck.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/maloney_assistant/sales-tax-agent/logs/healthcheck.err.log</string>
</dict>
</plist>
