<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac Mini agent: folder watcher + APScheduler cron jobs.

  Label matches the job already installed at
  ~/Library/LaunchAgents/com.tallowbourn.salestax.plist — keep them identical so
  `launchctl` manages one job, not two.

  RunAtLoad + KeepAlive means the agent starts at login and is restarted if it
  ever exits, so the daily syncs survive a reboot with no terminal.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tallowbourn.salestax</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/maloney_assistant/sales-tax-agent/.venv/bin/python</string>
        <!-- -u: unbuffered, so logs/agent.out.log is readable live instead of
             appearing in 4KB bursts hours later. -->
        <string>-u</string>
        <string>-m</string>
        <string>src.main</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/maloney_assistant/sales-tax-agent</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/maloney_assistant/sales-tax-agent/logs/agent.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/maloney_assistant/sales-tax-agent/logs/agent.err.log</string>
</dict>
</plist>
