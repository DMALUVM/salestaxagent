<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac Mini agent: folder watcher + APScheduler cron jobs + heartbeat.

  Label matches the job installed at
  ~/Library/LaunchAgents/com.tallowbourn.salestax.plist — keep them identical so
  `launchctl` manages one job, not two. They HAD drifted: the installed copy was
  missing -u (logs appeared in 4KB bursts, hours late) and this copy was missing
  ThrottleInterval and the venv on PATH. This file is the reconciled union.

  RunAtLoad + KeepAlive means the agent starts at login and is restarted if it
  ever exits, so every scheduled job survives a reboot with no terminal.

  Auto-update is an APScheduler job inside this process (04:30 ET + once
  shortly after start), not a second plist. After a successful ff-only
  pull it exits; KeepAlive is what loads the new code. Do not add another
  LaunchAgent that also runs `src.main run`.

  Liveness has two independent signals, and they detect different failures:
    - the heartbeat file (logs/heartbeat.json), stamped every 5 minutes, catches
      a process that is ALIVE but whose job threads have wedged;
    - the absence of the 08:10 Telegram check-in catches a process that is DEAD,
      because a dead scheduler cannot report on itself.
  A missing morning message is therefore itself an alarm.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tallowbourn.salestax</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/maloney_assistant/sales-tax-agent/.venv/bin/python</string>
        <!-- -u: unbuffered, so logs/agent.out.log is readable live instead of
             appearing in 4KB bursts hours later. -->
        <string>-u</string>
        <string>-m</string>
        <string>src.main</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/maloney_assistant/sales-tax-agent</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- The venv bin comes first so any subprocess resolves the project
             interpreter rather than the system one. -->
        <key>PATH</key>
        <string>/Users/maloney_assistant/sales-tax-agent/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <!-- Set to 0 to mute the daily Telegram check-in without stopping the
             health CHECK itself (faults are still logged and visible via
             `health-ping --dry-run`). -->
        <key>HEALTH_TELEGRAM</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/maloney_assistant/sales-tax-agent/logs/agent.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/maloney_assistant/sales-tax-agent/logs/agent.err.log</string>

    <!-- Don't respawn faster than every 10s if it is crash-looping. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
