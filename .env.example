# Failure-only Mini health check (scripts/healthcheck_wake.py, 07:23 ET).
# Missing URL or key: the check logs once and exits nonzero. It does not
# Telegram. VERCEL_TOKEN unset skips the deployment check (not a failure).
# GROKBOT_HEALTH_WEBHOOK_URL=
# GROKBOT_HEALTH_WEBHOOK_KEY=
# GROKBOT_HEALTH_WEBHOOK_HEADER=Authorization: Bearer <key>
# GROKBOT_ADS_CLEAR_DEADLINE=07:15
# GROKBOT_SYNC_LAUNCHD_LABEL=com.tallowbourn.salestax
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Agent Settings
INCOMING_DIR=~/sales-tax-agent/incoming
ARCHIVE_DIR=~/sales-tax-agent/archive
SHOPIFY_POLL_INTERVAL_HOURS=4
FOLDER_WATCH_INTERVAL_SECONDS=60
ALERT_DAYS_BEFORE_DEADLINE=14
ECONOMIC_NEXUS_WARN_PERCENT=80
ECONOMIC_NEXUS_CAUTION_PERCENT=50
