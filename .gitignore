.env
venv/
__pycache__/
*.pyc
.DS_Store
archive/
incoming/amazon/*.csv
incoming/amazon/*.txt
incoming/shopify/*.csv
*.egg-info/
dist/
build/
.pytest_cache/
.vercel
.env*

# Agent runtime state, not source. The heartbeat is a liveness stamp and the
# health state is a debounce ledger — both are machine-local and meaningless
# in another checkout, and committing them would make one machine's "already
# alerted today" suppress another's first alert. launchd stdout/stderr logs
# grow on the Mac mini and would otherwise dirty tracked files, which aborts
# git_auto_update.
logs/heartbeat.json
logs/heartbeat.tmp
logs/health_state.json
logs/ads_sync.lock.json
logs/ads_sync.lock.tmp
logs/*.log

# Generated exports / CPA packets / filing CSVs — never commit business data.
exports/
exports/**
!exports/playbooks/
!exports/playbooks/**

# Next.js / Node build artifacts (also covered under dashboard/.gitignore)
.next/
.next/**
node_modules/
**/node_modules/
out/
.turbo/
